# Copy to server/.env (which git ignores) and fill in. These are read by the server only and
# are never shipped to the browser. Do not put real values in this file.

# Where the server listens. The app's dev server sends /api and /media here.
HOST=127.0.0.1
PORT=8787

# The PostgreSQL database. Quote a password that holds # or spaces.
PGHOST=localhost
PGPORT=5432
PGDATABASE=kuhedu_languagedb
PGUSER=
PGPASSWORD=''

# Accounts. All optional on a developer's machine; the first three are required in production.
# At least 32 random characters, e.g. from: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
#SESSION_SECRET=
# Sending the codes that verify an address and reset a password. Without these, development
# writes each code to the server's log instead of sending it.
#SMTP_URL=smtp://user:password@smtp.example.com:587
#MAIL_FROM="Kuhedu <no-reply@example.com>"
# Google sign-in is offered only when this is set (and VITE_GOOGLE_CLIENT_ID for the app).
#GOOGLE_CLIENT_ID=
# true only behind the HTTPS server that passes requests on to this one.
#TRUST_PROXY=false

# Voices. The speaking service (speech/tts, `npm run dev:speech`) listens here, on this machine.
# Without it the app is silent.
#SPEECH_URL=http://127.0.0.1:8788
# Where sounds already made are kept. Left out: server/var/speech.
#SPEECH_CACHE_DIR=
