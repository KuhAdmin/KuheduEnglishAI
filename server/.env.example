# Copy to server/.env (which git ignores) and fill in. These are read by the server only and
# are never shipped to the browser. Do not put real values in this file.

# Where the server listens. The app's dev server sends /api and /media here.
HOST=127.0.0.1
PORT=8787

# The PostgreSQL database. Quote a password that holds # or spaces.
PGHOST=localhost
PGPORT=5432
PGDATABASE=kuhedu_languagedb
PGUSER=
PGPASSWORD=''

# Accounts. All optional on a developer's machine. Production needs SESSION_SECRET and a way to
# send (RESEND_API_KEY or SMTP_URL).
# At least 32 random characters, e.g. from: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
#SESSION_SECRET=
# Sending the codes that finish creating an account and reset a password. With neither way
# set, development writes each code to the server's log instead of sending it.
# Try it with: npm run mail:test -w @kuhedu/server -- delivered@resend.dev
# 1. Resend (resend.com): its key, and the address it sends as, whose domain is verified there.
#RESEND_API_KEY=
#RESEND_FROM_EMAIL=hello@lingo.kuhedu.com
# 2. Or a mail server, with the account allowed to send as MAIL_FROM. A password with @ : / or #
# in it is written percent-encoded.
#SMTP_URL=smtp://user:password@smtp.example.com:587
# Who the codes come from when RESEND_FROM_EMAIL does not say. Left out:
# Kuhedu Lingo <hello@lingo.kuhedu.com>
#MAIL_FROM="Kuhedu Lingo <hello@lingo.kuhedu.com>"
# Google sign-in is offered only when both are set (and VITE_GOOGLE_CLIENT_ID for the app).
# The secret is a secret. In the Google client, list among the authorized redirect URIs:
#   <the app's address>/api/auth/google/callback   (http://localhost:5173/... in development)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
# true only behind the HTTPS server that passes requests on to this one.
#TRUST_PROXY=false

# Voices. The speaking service (speech/tts, `npm run dev:speech`) listens here, on this machine.
# Without it the app is silent.
#SPEECH_URL=http://127.0.0.1:8788
# Where sounds already made are kept. Left out: server/var/speech.
#SPEECH_CACHE_DIR=

# Pronunciation. The scoring service (speech/assess, `npm run dev:scorer`) listens here, on this
# machine. Without it a recording cannot be checked, and the app says so; nothing else is affected.
#SCORER_URL=http://127.0.0.1:8789

# Replies in a role-play. The scoring service above writes down what a learner said; Ollama, on
# this machine, runs the model that reads it (`npm run dev:grader`). Without either, a reply
# cannot be checked, and the app says so; the role-play itself goes on as before.
#GRADER_URL=http://127.0.0.1:11434
#GRADER_MODEL=qwen2.5:1.5b
# Only `npm run dev:grader` reads these: where Ollama is when it is not on the PATH, and where
# it keeps its models and its temporary files when not on the system drive.
#OLLAMA_BIN=
#OLLAMA_MODELS=
#OLLAMA_TMPDIR=
