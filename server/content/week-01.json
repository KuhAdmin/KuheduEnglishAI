            "hi": "मैं ठीक हूँ, धन्यवाद।"
          }
        },
        {
          "speaker": "Meera",
          "text": "I’m Meera. What’s your name?",
          "translations": {
            "bn": "আমি মীরা। আপনার নাম কী?",
            "hi": "मैं मीरा हूँ। आपका नाम क्या है?"
