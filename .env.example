# Base URL of the Kuhedu backend / AI proxy. Never put AI provider keys in VITE_* variables:
# everything prefixed VITE_ is shipped to the browser.
VITE_API_BASE_URL=/api

# Google sign-in. This id is public (it is in the page for Google's own script); the server
# needs the same one as GOOGLE_CLIENT_ID. Without it the button says it is not available.
#VITE_GOOGLE_CLIENT_ID=
