# Base URL of the Kuhedu backend / AI proxy. Never put AI provider keys in VITE_* variables:
# everything prefixed VITE_ is shipped to the browser.
VITE_API_BASE_URL=/api

# Google sign-in. This id is public; here it only says that the server is set up for Google
# (GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in server/.env). Without it the button says Google
# is not available.
#VITE_GOOGLE_CLIENT_ID=
