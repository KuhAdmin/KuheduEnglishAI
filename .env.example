# Base URL of the Kuhedu backend / AI proxy. Never put AI provider keys in VITE_* variables:
# everything prefixed VITE_ is shipped to the browser.
VITE_API_BASE_URL=/api

# Local admin sign-in — a TESTING stand-in while there is no backend. Not security: these values
# are shipped to the browser like every VITE_* variable. Set VITE_LOCAL_ADMIN=false to disable.
VITE_LOCAL_ADMIN=true
VITE_LOCAL_ADMIN_USERNAME=admin
VITE_LOCAL_ADMIN_PASSWORD=Kuhedu@123
